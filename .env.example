# ZentroMart VoiceOps 2026 - Environment Configuration
# Copy this file to .env and insert your personal API keys

# Gnani.ai API Key (app.gnani.ai/voice)
# Required for live Gnani STT and TTS speech models
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE=Kaveri

# Primary LLM Provider: 'gemini', 'openai', or 'offline'
LLM_PROVIDER=gemini

# Google Gemini API Key (if using Gemini as LLM brain)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (if using OpenAI as LLM brain)
OPENAI_API_KEY=your_openai_api_key_here
